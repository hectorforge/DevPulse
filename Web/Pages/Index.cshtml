@page
@model Web.Pages.IndexModel
@{
    ViewData["Title"] = "Gestión de Incidentes";
}

<div class="container my-4">
    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3">Dashboard de Incidentes</h1>
        <a asp-page="/Incidents/Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Nuevo Incidente
        </a>
    </div>

    <!-- Mensajes de Alerta (TempData) -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Formulario de Búsqueda y Filtros -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-5">
                    <label asp-for="SearchName" class="form-label">Buscar por título</label>
                    <input asp-for="SearchName" class="form-control" placeholder="Escribe para buscar..." />
                </div>
                <div class="col-md-4">
                    <label asp-for="FilterSeverity" class="form-label">Filtrar por Severidad</label>
                    <select asp-for="FilterSeverity" class="form-select" asp-items="Html.GetEnumSelectList<Domain.Enums.Severity>()">
                        <option value="">-- Todas --</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-secondary w-100">Filtrar</button>
                    <a asp-page="./Index" class="btn btn-outline-secondary">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de Incidentes -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Título</th>
                            <th>Severidad</th>
                            <th>Estado</th>
                            <th>Fecha Reportada</th>
                            <th>Fecha Resolución</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Incidents != null && Model.Incidents.Any())
                        {
                            foreach (var incident in Model.Incidents)
                            {
                                <tr>
                                    <td class="fw-bold">@incident.Title</td>
                                    <td>
                                        <span class="badge @Model.GetSeverityBadgeClass(incident.Severity)">@incident.Severity</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark">@incident.Status</span>
                                    </td>
                                    
                                    <td>
                                        @(incident.ReportedAt.ToString("g"))
                                    </td>
                                    
                                    <td>
                                        @(incident.ResolvedAt)
                                    </td>
                                    
                                    <td class="text-end">
                                        <a asp-page="./Details" asp-route-id="@incident.Id" class="btn btn-sm btn-outline-info" title="Ver detalles">
                                            <i class="bi bi-eye"></i> Ver
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@incident.Id" data-title="@incident.Title" title="Eliminar">
                                            <i class="bi bi-trash"></i> Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No se encontraron incidentes registrados.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Confirmación de Eliminación -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Delete">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">Confirmar Eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="deleteIncidentId" name="id" />
                    <p>¿Estás seguro de que deseas eliminar el incidente <strong id="deleteIncidentTitle"></strong>?</p>
                    <p class="text-danger small">Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModal = document.getElementById('deleteModal');
            if (deleteModal) {
                deleteModal.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    var incidentId = button.getAttribute('data-id');
                    var incidentTitle = button.getAttribute('data-title');

                    var inputId = deleteModal.querySelector('#deleteIncidentId');
                    var titleSpan = deleteModal.querySelector('#deleteIncidentTitle');

                    inputId.value = incidentId;
                    titleSpan.textContent = incidentTitle;
                });
            }
        });
    </script>
}