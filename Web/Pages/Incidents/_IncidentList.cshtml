@using Domain.Enums
@using Application.Mappings
@model Web.Pages.Incidents.IndexModel

<!-- Tabla -->
<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th style="width: 30%">Título e ID</th>
                <th>Severidad</th>
                <th>Estado</th>
                <th>Fecha Reporte</th>
                <th>Responsable</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Incidents.Any())
            {
                foreach (var item in Model.Incidents)
                {
                    <tr>
                        <td>
                            <div class="fw-bold text-primary">@item.Title</div>
                            <small class="text-muted text-uppercase" style="font-size: 0.7rem;">ID: @item.Id.ToString().Substring(0, 8)...</small>
                        </td>
                        <td>
                            @{
                                var sevClass = item.Severity switch {
                                    Severity.Critical => "bg-danger",
                                    Severity.High => "bg-warning text-dark",
                                    Severity.Medium => "bg-info text-dark",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @sevClass">@item.Severity.ToFriendlyString()</span>
                        </td>
                        <td>
                            <span class="badge rounded-pill border border-dark text-dark">
                                <i class="bi bi-circle-fill me-1 small"></i> @item.Status.ToFriendlyString()
                            </span>
                        </td>
                        <td>
                            <div class="small">@item.ReportedAt.ToString("dd/MM/yyyy")</div>
                            <div class="text-muted small">@item.ReportedAt.ToString("HH:mm")</div>
                        </td>
                        <td>
                            @if (string.IsNullOrEmpty(item.NameTeamMember))
                            {
                                <span class="text-danger small italic"><i class="bi bi-person-x"></i> Sin asignar</span>
                            }
                            else
                            {
                                <span class="text-dark small fw-bold"><i class="bi bi-person-check text-success"></i> @item.NameTeamMember</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group shadow-sm">
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="openModal('@Url.Page("./Index", "AssignModal", new { id = item.Id })')">
                                    <i class="bi bi-person-plus-fill"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-warning" onclick="openModal('@Url.Page("./Index", "EditModal", new { id = item.Id })')">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                @if (!string.IsNullOrEmpty(item.ScreenshotUrl))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-info" onclick="openModal('@Url.Page("./Index", "ScreenshotModal", new { id = item.Id })')">
                                        <i class="bi bi-camera-fill"></i>
                                    </button>
                                }
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="openModal('@Url.Page("./Index", "DeleteModal", new { id = item.Id })')">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center py-5">
                        <i class="bi bi-clipboard-x display-4 text-muted"></i>
                        <p class="mt-2 text-muted">No se encontraron incidentes.</p>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Paginación -->
<div class="card-footer bg-white d-flex justify-content-between align-items-center border-top-0">
    <div class="text-muted small">
        Mostrando página @Model.CurrentPage de @Model.TotalPages (@Model.TotalRecords registros totales)
    </div>
    <nav>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="javascript:void(0)" onclick="changePage(@(Model.CurrentPage - 1))">Anterior</a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="javascript:void(0)" onclick="changePage(@i)">@i</a>
                </li>
            }

            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="javascript:void(0)" onclick="changePage(@(Model.CurrentPage + 1))">Siguiente</a>
            </li>
        </ul>
    </nav>
</div>