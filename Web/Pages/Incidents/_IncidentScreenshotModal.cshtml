@model Application.DTOs.IncidentDto

<div class="modal-header bg-dark text-white">
    <h5 class="modal-title">
        <i class="bi bi-image me-2"></i> Evidencia: @Model.Title
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body p-0 bg-dark text-center d-flex align-items-center justify-content-center" style="min-height: 400px;">
    @if (!string.IsNullOrEmpty(Model.ScreenshotUrl))
    {
        <img src="@Model.ScreenshotUrl" 
             class="img-fluid shadow-lg" 
             alt="Captura del incidente" 
             style="max-height: 80vh; object-fit: contain;" />
    }
    else
    {
        <div class="py-5">
            <i class="bi bi-image-fill display-1 text-muted"></i>
            <p class="text-muted">Este incidente no tiene una captura cargada.</p>
        </div>
    }
</div>

<div class="modal-footer bg-light">
    <small class="text-muted me-auto">ID: @Model.Id</small>
    @if (!string.IsNullOrEmpty(Model.ScreenshotUrl))
    {
        <a href="@Model.ScreenshotUrl" target="_blank" class="btn btn-outline-primary shadow-sm">
            <i class="bi bi-box-arrow-up-right me-1"></i> Abrir Original
        </a>
    }
    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cerrar</button>
</div>