@model Application.DTOs.AssignIncidentRequest
<div class="modal-header bg-primary text-white">
    <h5 class="modal-title">Asignar Responsable</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
</div>
<form asp-page-handler="Assign" id="incidentForm" method="post">
    <div class="modal-body">
        <input type="hidden" asp-for="IncidentId" />
        <p>Asignando técnico para el incidente: <strong>@ViewData["IncidentTitle"]</strong></p>
        
        <div class="mb-3">
            <label class="form-label fw-bold">Seleccionar Miembro del Equipo</label>
            <select asp-for="TeamMemberId" class="form-select" 
                    asp-items="@((IEnumerable<SelectListItem>)ViewContext.Values["TeamMemberOptions"] ?? (IEnumerable<SelectListItem>)((Web.Pages.Incidents.IndexModel)ViewContext.ViewData.Model).TeamMemberOptions)">
                <option value="">-- Seleccione un técnico --</option>
            </select>
            <span asp-validation-for="TeamMemberId" class="text-danger"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary">Confirmar Asignación</button>
    </div>
</form>