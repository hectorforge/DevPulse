@page "/incidents"
@using Application.Mappings
@using Domain.Enums
@model Web.Pages.Incidents.IndexModel
@{
    ViewData["Title"] = "Gestión de Incidentes";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800"><i class="bi bi-exclamation-octagon-fill text-danger"></i> Centro de Incidentes</h1>
            <p class="text-muted">Monitoreo y resolución de tickets técnicos.</p>
        </div>
        <button type="button" class="btn btn-primary btn-lg shadow-sm" onclick="openModal('@Url.Page("./Index", "CreateModal")')">
            <i class="bi bi-plus-lg"></i> Reportar Incidente
        </button>
    </div>

    <!-- Filtros -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body bg-light rounded">
            <form method="get" class="row g-3">
                <div class="col-md-5">
                    <label class="form-label fw-bold">Buscar por título</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input asp-for="SearchName" class="form-control" placeholder="Ej: Error en servidor..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Severidad</label>
                    <select asp-for="FilterSeverity" class="form-select" asp-items="Model.SeverityOptions">
                        <option value="">-- Todas las severidades --</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-dark w-100">Filtrar</button>
                    <a asp-page="./Index" class="btn btn-outline-secondary w-100">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 30%">Título e ID</th>
                        <th>Severidad</th>
                        <th>Estado</th>
                        <th>Fecha Reporte</th>
                        <th>Responsable</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Incidents.Any())
                    {
                        foreach (var item in Model.Incidents)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-primary">@item.Title</div>
                                    <small class="text-muted text-uppercase" style="font-size: 0.7rem;">ID: @item.Id.ToString().Substring(0,8)...</small>
                                </td>
                                <td>
                                    @{
                                        var sevClass = item.Severity switch {
                                            Severity.Critical => "bg-danger",
                                            Severity.High => "bg-warning text-dark",
                                            Severity.Medium => "bg-info text-dark",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @sevClass">@item.Severity.ToFriendlyString()</span>
                                </td>
                                <td>
                                    <span class="badge rounded-pill border border-dark text-dark">
                                        <i class="bi bi-circle-fill me-1 small"></i> @item.Status.ToFriendlyString()
                                    </span>
                                </td>
                                <td>
                                    <div class="small">@item.ReportedAt.ToString("dd/MM/yyyy")</div>
                                    <div class="text-muted small">@item.ReportedAt.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    @if (string.IsNullOrEmpty(item.NameTeamMember))
                                    {
                                        <span class="text-danger small italic"><i class="bi bi-person-x"></i> Sin asignar</span>
                                    }
                                    else
                                    {
                                        <span class="text-dark small fw-bold"><i class="bi bi-person-check text-success"></i> @item.NameTeamMember</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group shadow-sm">
                                        <!-- Botón Asignar -->
                                        <button type="button" class="btn btn-sm btn-outline-primary" title="Asignar Responsable"
                                                onclick="openModal('@Url.Page("./Index", "AssignModal", new { id = item.Id })')">
                                            <i class="bi bi-person-plus-fill"></i>
                                        </button>
                                        <!-- Botón Editar -->
                                        <button type="button" class="btn btn-sm btn-outline-warning" title="Editar"
                                                onclick="openModal('@Url.Page("./Index", "EditModal", new { id = item.Id })')">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <!-- Botón Eliminar -->
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Eliminar"
                                                onclick="openModal('@Url.Page("./Index", "DeleteModal", new { id = item.Id })')">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <i class="bi bi-clipboard-x display-4 text-muted"></i>
                                <p class="mt-2 text-muted">No se encontraron incidentes que coincidan con los criterios.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="formModal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" id="modalContent">
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalElement = document.getElementById('formModal');
        const modal = new bootstrap.Modal(modalElement);
        const modalBody = document.querySelector('#modalContent');

        const openModal = async (url) => {
            modalBody.innerHTML = `
                <div class="p-5 text-center">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2">Cargando formulario...</p>
                </div>`;
            modal.show();

            try {
                const response = await fetch(url);
                const html = await response.text();
                modalBody.innerHTML = html;
                
                const form = modalBody.querySelector('form');
                if (form) {
                    form.addEventListener('submit', handleFormSubmit);
                }
            } catch (err) {
                Swal.fire('Error', 'No se pudo cargar el formulario', 'error');
            }
        };

        const handleFormSubmit = async (e) => {
            e.preventDefault();
            const form = e.currentTarget;
            const formData = new FormData(form);
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            
            const btn = form.querySelector('button[type="submit"]');
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Procesando...';

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: { 'RequestVerificationToken': token }
                });

                const result = await response.json();

                if (result.success) {
                    modal.hide();
                    await Swal.fire({
                        icon: 'success',
                        title: 'Completado',
                        text: result.message,
                        timer: 1500,
                        showConfirmButton: false
                    });
                    location.reload();
                } else {
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                    renderErrors(result.message, result.errors);
                }
            } catch (err) {
                btn.disabled = false;
                btn.innerHTML = originalText;
                Swal.fire('Error', 'Error de red o de servidor', 'error');
            }
        };

        const renderErrors = (message, errors) => {
            document.querySelectorAll('.text-danger.field-validation-error').forEach(el => el.innerText = '');
            
            if (errors) {
                Object.entries(errors).forEach(([key, value]) => {
                    const span = document.querySelector(`[data-valmsg-for="${key}"]`) || 
                                 document.querySelector(`[data-valmsg-for="input.${key}"]`);
                    if (span) span.innerText = value;
                });
            }
            
            Swal.fire({
                icon: 'error',
                title: 'No se pudo procesar',
                text: message || 'Revisa los campos del formulario.'
            });
        };
    </script>
}