@using Domain.Enums
@using Application.DTOs
@model dynamic 

@{
    bool isEdit = ViewData.Model is UpdateIncidentRequest;
    
    var severityOptions = Enum.GetValues<Severity>().Select(s => new SelectListItem 
    { 
        Text = s.ToString(), 
        Value = s.ToString() 
    });

    var statusOptions = Enum.GetValues<IncidentStatus>().Select(s => new SelectListItem 
    { 
        Text = s.ToString(),
        Value = s.ToString() 
    });
}

<form asp-page-handler="@(isEdit ? "Edit" : "Create")" id="incidentForm" method="post">
    @Html.AntiForgeryToken()
    <div class="modal-header @(isEdit ? "bg-warning text-dark" : "bg-primary text-white")">
        <h5 class="modal-title">
            <i class="bi @(isEdit ? "bi-pencil-square" : "bi- megaphone")"></i>
            @(isEdit ? "Editar Incidente" : "Reportar Nuevo Incidente")
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    
    <div class="modal-body">
        @if (isEdit) 
        { 
            <input type="hidden" name="Id" value="@Model.Id" /> 
        }
        
        <div class="mb-3">
            <label class="form-label fw-bold">Título del Incidente</label>
            <input name="Title" value="@Model.Title" class="form-control" placeholder="Resumen corto del problema" />
            <span data-valmsg-for="Title" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Descripción Detallada</label>
            <textarea name="Description" class="form-control" rows="4" placeholder="Pasos para reproducir, logs, etc...">@Model.Description</textarea>
            <span data-valmsg-for="Description" class="text-danger small"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Severidad</label>
                <select name="Severity" class="form-select" asp-items="severityOptions">
                    @if (!isEdit) { <option value="">-- Seleccione --</option> }
                </select>
                <span data-valmsg-for="Severity" class="text-danger small"></span>
            </div>

            @if (isEdit) 
            {
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Estado Actual</label>
                    <select name="Status" class="form-select" asp-items="statusOptions">
                    </select>
                    <span data-valmsg-for="Status" class="text-danger small"></span>
                </div>
            }
        </div>

        <div id="errorSummary" class="alert alert-danger d-none mt-2"></div>
    </div>

    <div class="modal-footer bg-light">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn @(isEdit ? "btn-warning" : "btn-primary") px-4">
            @(isEdit ? "Actualizar Incidente" : "Reportar Incidente")
        </button>
    </div>
</form>