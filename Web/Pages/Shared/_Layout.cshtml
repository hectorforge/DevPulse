<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DevPulse</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <style>
        body {
            background-color: #f8f9fc;
            overflow-x: hidden;
        }
        
        #wrapper {
            display: flex;
            width: 100%;
            align-items: stretch;
        }
    
        #sidebar {
            min-width: 250px;
            max-width: 250px;
            width: 250px;
            height: 100vh;  
            position: sticky;
            top: 0;
            background: #212529; 
            color: #fff;
            transition: all 0.3s;
            z-index: 1000;
            margin-left: 0;
        }
    
        #sidebar.active {
            margin-left: -250px;
        }
    
        #sidebar .sidebar-header {
            padding: 20px;
            background: #1a1d20;
            border-bottom: 1px solid #343a40;
        }
    
        #sidebar ul.components {
            padding: 20px 0;
        }
    
        #sidebar ul li a {
            padding: 12px 20px;
            font-size: 1.1em;
            display: block;
            color: #adb5bd;
            text-decoration: none;
            transition: 0.3s;
        }
    
        #sidebar ul li a:hover {
            color: #fff;
            background: #343a40;
        }
    
        #sidebar ul li.active > a {
            color: #fff;
            background: #0d6efd;
            border-radius: 0 25px 25px 0;
            margin-right: 15px;
        }
        
        #content {
            width: 100%;
            padding: 0;
            min-height: 100vh;
            transition: all 0.3s;
        }
    
        .top-navbar {
            padding: 5px 20px;
            background: #fff;
            border: none;
            border-radius: 0;
            margin-bottom: 0;
            box-shadow: 0 2px 10px rgba(0,0,0,.05);
        }
    
        .main-container {
            padding: 5px 15px;
        }
    
        footer {
            background: #fff;
            padding: 15px 0;
        }
        
        @@media (max-width: 768px) {
            #sidebar {
                margin-left: -250px;
                position: fixed;
            }
            #sidebar.active {
                margin-left: 0;
            }
        }
    </style>
</head>
<body>

@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
}

<div id="wrapper">
    <nav id="sidebar" class="shadow-lg">
        <div class="sidebar-header text-center">
            <a class="navbar-brand fs-3 fw-bold text-white d-flex align-items-center justify-content-center" asp-page="/Index">
                <i class="bi bi-cpu-fill me-2 text-primary"></i> DevPulse
            </a>
        </div>

        <ul class="list-unstyled components">
            <p class="text-muted small fw-bold px-4 text-uppercase mb-2" style="font-size: 0.7rem;">Principal</p>
            <li class="@(currentPage.Contains("/Incidents") ? "active" : "")">
                <a asp-area="" asp-page="/Incidents/Index">
                    <i class="bi bi-exclamation-octagon me-2"></i> Incidents
                </a>
            </li>
            <li class="@(currentPage.Contains("/TeamMembers") ? "active" : "")">
                <a asp-area="" asp-page="/TeamMembers/Index">
                    <i class="bi bi-people me-2"></i> Team Members
                </a>
            </li>
            <li class="@(currentPage.Contains("/PostMortems") ? "active" : "")">
                <a asp-area="" asp-page="/PostMortems/Index">
                    <i class="bi bi-journal-text me-2"></i> Post Mortems
                </a>
            </li>

            <hr class="mx-3 opacity-25">

            <p class="text-muted small fw-bold px-4 text-uppercase mb-2" style="font-size: 0.7rem;">Configuración</p>
            <li>
                <a asp-page="/Privacy">
                    <i class="bi bi-shield-lock me-2"></i> Privacy
                </a>
            </li>
        </ul>
    </nav>

    <div id="content">
        <nav class="navbar navbar-expand-lg top-navbar">
            <div class="container-fluid">
                <button type="button" id="sidebarCollapse" class="btn btn-outline-dark border-0">
                    <i class="bi bi-list fs-4"></i>
                </button>

                <div class="ms-auto d-flex align-items-center">
                    <span class="text-muted me-3 small">Sistema de Monitoreo v1.0</span>
                    <div class="dropdown">
                        <a class="btn btn-light rounded-circle shadow-sm" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle text-primary"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow">
                            <li><a class="dropdown-item" href="#">Mi Perfil</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="#">Cerrar Sesión</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>

        <div class="main-container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>

        <footer class="footer text-muted border-top">
            <div class="container-fluid px-4">
                <div class="d-flex justify-content-between align-items-center">
                    <span>&copy; 2026 - <b>DevPulse</b> Tech Ops</span>
                    <nav>
                        <a asp-page="/Privacy" class="text-decoration-none small text-muted">Privacy Policy</a>
                    </nav>
                </div>
            </div>
        </footer>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {
        $('#sidebarCollapse').on('click', function () {
            $('#sidebar').toggleClass('active');
        });
    });
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>