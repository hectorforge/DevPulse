@page "/team"
@using Domain.Enums
@model Web.Pages.TeamMembers.IndexModel
@{
    ViewData["Title"] = "Gestión de Equipo";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800"><i class="bi bi-people-fill text-primary"></i> Directorio de Equipo</h1>
            <p class="text-muted">Gestión de personal, roles y accesos al sistema.</p>
        </div>
        <button type="button" class="btn btn-primary btn-lg shadow-sm" onclick="openModal('@Url.Page("./Index", "CreateModal")')">
            <i class="bi bi-person-plus"></i> Nuevo Miembro
        </button>
    </div>

    <!-- Filtros -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body bg-light rounded">
            <form method="get" class="row g-3">
                <div class="col-md-5">
                    <label class="form-label fw-bold">Buscar por nombre o email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input asp-for="SearchName" class="form-control" placeholder="Ej: Juan Pérez o juan@empresa.com..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Filtrar por Rol</label>
                    <select asp-for="SearchRole" class="form-select" asp-items="Model.RoleOptions">
                        <option value="">-- Todos los roles --</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-dark w-100">Filtrar</button>
                    <a asp-page="./Index" class="btn btn-outline-secondary w-100">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 30%">Miembro e ID</th>
                        <th>Correo Electrónico</th>
                        <th>Rol / Posición</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.TeamMembers.Any())
                    {
                        foreach (var item in Model.TeamMembers)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-primary">@item.Name</div>
                                    <small class="text-muted text-uppercase" style="font-size: 0.7rem;">ID: @item.Id.ToString().Substring(0, 8)...</small>
                                </td>
                                <td>
                                    <div class="text-dark"><i class="bi bi-envelope me-2 text-muted"></i>@item.Email</div>
                                </td>
                                <td>
                                    @{
                                        var roleClass = item.Role.ToString() switch {
                                            "Admin" => "bg-dark",
                                            "Manager" => "bg-purple text-white",
                                            "Developer" => "bg-primary",
                                            _ => "bg-info text-dark"
                                        };
                                    }
                                    <span class="badge @roleClass">
                                        <i class="bi bi-person-badge me-1"></i> @Model.GetRoleDisplay(item.Role)
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group shadow-sm">
                                        <!-- Botón Editar -->
                                        <button type="button" class="btn btn-sm btn-outline-warning" title="Editar Miembro"
                                                onclick="openModal('@Url.Page("./Index", "EditModal", new { id = item.Id })')">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <!-- Botón Eliminar -->
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Eliminar Miembro"
                                                onclick="openModal('@Url.Page("./Index", "DeleteModal", new { id = item.Id })')">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5">
                                <i class="bi bi-people display-4 text-muted"></i>
                                <p class="mt-2 text-muted">No se encontraron miembros del equipo.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Paginación -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link shadow-sm" asp-page="./Index" asp-route-CurrentPage="@(Model.CurrentPage - 1)" 
                       asp-route-SearchName="@Model.SearchName" asp-route-SearchRole="@Model.SearchRole">Anterior</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link shadow-sm" asp-page="./Index" asp-route-CurrentPage="@i"
                           asp-route-SearchName="@Model.SearchName" asp-route-SearchRole="@Model.SearchRole">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link shadow-sm" asp-page="./Index" asp-route-CurrentPage="@(Model.CurrentPage + 1)"
                       asp-route-SearchName="@Model.SearchName" asp-route-SearchRole="@Model.SearchRole">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div>

<!-- Modal -->
<div class="modal fade" id="formModal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" id="modalContent">
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalElement = document.getElementById('formModal');
        const modal = new bootstrap.Modal(modalElement);
        const modalBody = document.querySelector('#modalContent');

        const openModal = async (url) => {
            modalBody.innerHTML = `
                <div class="p-5 text-center">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2">Cargando datos del equipo...</p>
                </div>`;
            modal.show();

            try {
                const response = await fetch(url);
                const html = await response.text();
                modalBody.innerHTML = html;
                
                const form = modalBody.querySelector('form');
                if (form) {
                    form.addEventListener('submit', handleFormSubmit);
                }
            } catch (err) {
                Swal.fire('Error', 'No se pudo conectar con el servidor', 'error');
            }
        };

        const handleFormSubmit = async (e) => {
            e.preventDefault();
            const form = e.currentTarget;
            const formData = new FormData(form);
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            
            const btn = form.querySelector('button[type="submit"]');
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Guardando...';

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: { 'RequestVerificationToken': token }
                });

                const result = await response.json();

                if (result.success) {
                    modal.hide();
                    await Swal.fire({
                        icon: 'success',
                        title: '¡Éxito!',
                        text: result.message || 'Operación realizada correctamente',
                        timer: 1500,
                        showConfirmButton: false
                    });
                    location.reload();
                } else {
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                    renderErrors(result.message, result.errors);
                }
            } catch (err) {
                btn.disabled = false;
                btn.innerHTML = originalText;
                Swal.fire('Error', 'Error crítico al procesar la solicitud', 'error');
            }
        };

        const renderErrors = (message, errors) => {
            document.querySelectorAll('.text-danger.small').forEach(el => el.innerText = '');
            
            if (errors) {
                Object.entries(errors).forEach(([key, value]) => {
                    const span = document.querySelector(`[data-valmsg-for="${key}"]`);
                    if (span) span.innerText = value;
                });
            }
            
            Swal.fire({
                icon: 'error',
                title: 'Validación',
                text: message || 'Por favor, corrige los errores en el formulario.'
            });
        };
    </script>
}