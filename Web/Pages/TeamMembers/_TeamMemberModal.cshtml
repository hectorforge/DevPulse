@using Domain.Enums
@using Application.Mappings
@model Web.ViewModels.TeamMembers.TeamMemberFormViewModel

@{
    var roleOptions = Enum.GetValues<Role>().Select(r => new SelectListItem
    {
        Text = r.ToFriendlyString(),
        Value = r.ToString()
    });
}

<form asp-page-handler="@(Model.IsEdit ? "Edit" : "Create")" id="teamMemberForm" method="post">
    @Html.AntiForgeryToken()
    
    <div class="modal-header @(Model.IsEdit ? "bg-warning text-dark" : "bg-primary text-white")">
        <h5 class="modal-title">
            <i class="bi @(Model.IsEdit ? "bi-pencil-square" : "bi-person-plus")"></i>
            @(Model.IsEdit ? "Editar Miembro" : "Nuevo Miembro del Equipo")
        </h5>
        <button type="button" class="btn-close @(Model.IsEdit ? "" : "btn-close-white")" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        @if (Model.IsEdit)
        {
            <input type="hidden" asp-for="Id" />
        }

        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-bold">Nombre Completo</label>
            <input asp-for="Name" class="form-control" placeholder="Ej. Juan Pérez" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-bold">Correo Electrónico</label>
            <input asp-for="Email" class="form-control" placeholder="correo@empresa.com" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Role" class="form-label fw-bold">Rol en el Equipo</label>
            <select asp-for="Role" class="form-select" asp-items="roleOptions">
                @if (!Model.IsEdit) { <option value="">-- Seleccione un Rol --</option> }
            </select>
            <span asp-validation-for="Role" class="text-danger small"></span>
        </div>

        <div id="errorSummary" class="alert alert-danger d-none mt-2"></div>
    </div>

    <div class="modal-footer bg-light">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn @(Model.IsEdit ? "btn-warning" : "btn-primary") px-4 shadow-sm">
            <i class="bi bi-check-circle-fill me-2"></i>
            @(Model.IsEdit ? "Guardar Cambios" : "Crear Miembro")
        </button>
    </div>
</form>